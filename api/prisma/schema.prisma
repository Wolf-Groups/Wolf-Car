// Wolf Car showroom ordering — database schema.
//
// Constraints Prisma cannot express (partial unique indexes, CHECKs, deferred
// constraint triggers, the append-only activity log) live in hand-written SQL
// at the end of the first migration. See README → "Database constraints".

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FINANCE
  BRANCH_MANAGER
  CASHIER
  RESERVATIONS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PermissionEffect {
  GRANT
  REVOKE
}

enum SessionAudience {
  DASHBOARD
  SHOWROOM
}

/// Where an order was placed: the branch's showroom screen, or the website.
enum OrderSource {
  SHOWROOM
  WEB
}

/// Online payment of an order. Showroom orders stay NONE (paid at the till).
enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

/// One card attempt at Tap.
enum PaymentAttemptStatus {
  INITIATED
  CAPTURED
  FAILED
}

/// A paid web order on its way to Odoo.
enum OutboxStatus {
  PENDING
  DONE
  FAILED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum PpfBookingType {
  FULL
  LIGHT
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

enum LightJobRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Branch {
  id                     String    @id @default(uuid()) @db.Uuid
  /// Short uppercase code used as the order-number prefix, e.g. "GH".
  code                   String    @unique @db.VarChar(4)
  name                   String    @db.VarChar(120)
  nameAr                 String    @map("name_ar") @db.VarChar(120)
  isActive               Boolean   @default(true) @map("is_active")
  /// The cashier enters sales in Odoo by scanning barcodes off the showroom
  /// screen: the kiosk shows each product's barcode and keeps the basket closed.
  scanFromScreen         Boolean   @default(false) @map("scan_from_screen")
  /// The branch's till is not Odoo and knows a multi-colour product by one code:
  /// its screens show the colours' shared barcode, without Odoo's colour digit.
  barcodeWithoutColour   Boolean   @default(false) @map("barcode_without_colour")
  /// Hash of the 6-digit PIN the showroom screen signs in with; null until set.
  showroomPinHash        String?   @map("showroom_pin_hash")
  /// Wrong PINs since the last right one; locks the sign-in at LOGIN_MAX_ATTEMPTS.
  showroomPinFailedCount Int       @default(0) @map("showroom_pin_failed_count")
  showroomPinLockedUntil DateTime? @map("showroom_pin_locked_until") @db.Timestamptz(3)
  /// Per-branch order counter, incremented inside the order transaction.
  orderSeq               Int       @default(0) @map("order_seq")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  products BranchProduct[]
  orders   Order[]

  @@map("branches")
}

model User {
  id                        String    @id @default(uuid()) @db.Uuid
  username                  String    @unique @db.VarChar(40)
  displayName               String    @map("display_name") @db.VarChar(120)
  email                     String?   @unique @db.VarChar(254)
  role                      Role
  branchId                  String?   @map("branch_id") @db.Uuid
  passwordHash              String    @map("password_hash")
  showroomPasswordHash      String?   @map("showroom_password_hash")
  isActive                  Boolean   @default(true) @map("is_active")
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz(3)
  failedLoginCount          Int       @default(0) @map("failed_login_count")
  lockedUntil               DateTime? @map("locked_until") @db.Timestamptz(3)
  showroomFailedCount       Int       @default(0) @map("showroom_failed_count")
  showroomLockedUntil       DateTime? @map("showroom_locked_until") @db.Timestamptz(3)
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc        String?   @map("two_factor_secret_enc")
  twoFactorPendingSecretEnc String?   @map("two_factor_pending_secret_enc")
  /// Last accepted TOTP time step; codes from this step or earlier are rejected (replay protection).
  twoFactorLastStep         Int?      @map("two_factor_last_step")
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdById               String?   @map("created_by_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy             User?                    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers          User[]                   @relation("UserCreatedBy")
  sessions              Session[]
  recoveryCodes         RecoveryCode[]
  permissionOverrides   UserPermissionOverride[] @relation("OverrideUser")
  grantedOverrides      UserPermissionOverride[] @relation("OverrideGrantedBy")
  productsCreated       Product[]                @relation("ProductCreatedBy")
  productsUpdated       Product[]                @relation("ProductUpdatedBy")
  priceChanges          PriceHistory[]
  ordersCreated         Order[]                  @relation("OrderCreatedBy")
  ordersConfirmed       Order[]                  @relation("OrderConfirmedBy")
  ordersCancelled       Order[]                  @relation("OrderCancelledBy")
  ordersCollected       Order[]                  @relation("OrderCollectedBy")
  ppfBookingsCreated    PpfBooking[]             @relation("PpfBookingCreatedBy")
  ppfBookingsUpdated    PpfBooking[]             @relation("PpfBookingUpdatedBy")
  ppfBookingsCancelled  PpfBooking[]             @relation("PpfBookingCancelledBy")
  ppfDaysClosed         PpfClosedDay[]
  lightRequestsDecided  LightJobRequest[]
  reservationsCreated   GeneralReservation[]     @relation("ReservationCreatedBy")
  reservationsUpdated   GeneralReservation[]     @relation("ReservationUpdatedBy")
  reservationsCancelled GeneralReservation[]     @relation("ReservationCancelledBy")
  salesAccessUpdates    SalesAccess[]

  @@index([branchId])
  @@index([role])
  @@map("users")
}

model Permission {
  key         String @id @db.VarChar(64)
  group       String @db.VarChar(32)
  description String @db.VarChar(255)

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  role          Role
  permissionKey String   @map("permission_key") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId        String           @map("user_id") @db.Uuid
  permissionKey String           @map("permission_key") @db.VarChar(64)
  effect        PermissionEffect
  grantedById   String?          @map("granted_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation("OverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("OverrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@map("user_permission_overrides")
}

model Session {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  audience     SessionAudience
  /// Absolute expiry; refresh rotation never extends past it.
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?         @map("revoke_reason") @db.VarChar(40)
  lastUsedAt   DateTime        @default(now()) @map("last_used_at") @db.Timestamptz(3)
  ip           String?         @db.VarChar(64)
  userAgent    String?         @map("user_agent") @db.VarChar(512)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is rotated. Presenting a used token revokes the whole session (reuse detection).
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Catalogue grouping shown as the showroom tabs — usually a car model
/// ("ﻟﻴﻮﺑﺎرد 5"), sometimes an accessory line ("اكسسوارات تسلا").
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  /// English name for the public website's /en pages; `name` (Arabic) when null.
  nameEn    String?  @map("name_en") @db.VarChar(120)
  /// The car this grouping is for, as printed on the showroom header.
  carModel  String?  @map("car_model") @db.VarChar(120)
  /// UUID of the processed hero image in UPLOAD_DIR, as for Product.imageKey.
  imageKey  String?  @map("image_key") @db.Uuid
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  /// Primary key from the legacy Supabase catalogue ("cat-1787146025137"), so
  /// re-running the import updates rows instead of duplicating them.
  legacyId  String?  @unique @map("legacy_id") @db.VarChar(64)
  /// Id of the Odoo product category (product.category) this row was imported from.
  odooId    Int?     @unique @map("odoo_id")
  /// The brand a car model belongs to ("Leopard" for "Leopard 5"). A brand's
  /// own products are common to its models and are listed inside each of them.
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")

  @@index([position])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(2000)
  /// NOT unique: the legacy catalogue lists the same part once per car model,
  /// so 147 barcodes are shared by several products. Cashiers scan the code
  /// into their own counting system, where it identifies the part, not the row.
  barcode        String?   @db.VarChar(64)
  categoryId     String?   @map("category_id") @db.Uuid
  /// Primary key from the legacy Supabase catalogue ("prod-1787146069197").
  legacyId       String?   @unique @map("legacy_id") @db.VarChar(64)
  /// Id of the Odoo variant (product.product) this row was imported from, so
  /// re-running the Odoo import updates rows instead of duplicating them.
  odooId         Int?      @unique @map("odoo_id")
  /// False hides the product from the showroom, the website and the dashboard
  /// list. Rows are never deleted: past orders still point at them.
  isActive       Boolean   @default(true) @map("is_active")
  /// Listed under the website's "Quick service" tab (filters, oils, brake
  /// pads) as well as under its own car. Set in the dashboard, never by Odoo.
  isQuickService Boolean   @default(false) @map("is_quick_service")
  /// What Odoo's "last changed" dates were when this row was last synced. The
  /// sync skips a row whose stamp has not moved.
  odooStamp      String?   @map("odoo_stamp") @db.VarChar(80)
  /// Id of the Odoo product (product.template). Rows that share it are the
  /// colours or sizes of one product and are shown as one card with a picker.
  odooTemplateId Int?      @map("odoo_template_id")
  /// "أسود", "مطفي", … — null for a product that comes in one form only.
  variantLabel   String?   @map("variant_label") @db.VarChar(60)
  /// "#980606" for a colour variant, to draw its swatch.
  variantColor   String?   @map("variant_color") @db.VarChar(7)
  /// Units free to sell across Odoo's internal stock locations (on hand minus
  /// reserved), refreshed by every sync. Can be negative when Odoo is. Null
  /// for a product Odoo does not count, and for every product not from Odoo.
  odooStock      Int?      @map("odoo_stock")
  /// UUID of the processed image files in UPLOAD_DIR (<key>.webp and <key>-sm.webp).
  imageKey       String    @map("image_key") @db.Uuid
  /// Set on the hidden rows that hold one price of a service (see Service).
  /// Such a row is never listed with the catalogue and never comes from Odoo.
  serviceId      String?   @map("service_id") @db.Uuid
  /// Which package or film of the service this price is for; null when it has one.
  serviceTierId  String?   @map("service_tier_id") @db.Uuid
  /// "sedan" or "suv" when the service is priced by car type.
  serviceBody    String?   @map("service_body") @db.VarChar(10)
  /// Null until Finance sets it. Unpriced products are hidden from the showroom.
  price          Decimal?  @db.Decimal(12, 2)
  priceUpdatedAt DateTime? @map("price_updated_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy       User            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service         Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceTier     ServiceTier?    @relation(fields: [serviceTierId], references: [id], onDelete: Restrict)
  branchPositions BranchProduct[]
  priceHistory    PriceHistory[]
  orderItems      OrderItem[]

  @@index([name])
  @@index([barcode])
  @@index([categoryId])
  @@index([odooTemplateId])
  @@index([serviceId])
  @@map("products")
}

/// A service or package sold next to the parts: PPF, tint, polish, paint.
/// Kept here, not in Odoo, and edited in the dashboard. Each of its prices is
/// a hidden Product row (Product.serviceId), so a service goes into an order,
/// onto the cashier's screen and onto a receipt exactly as a part does.
model Service {
  id        String   @id @default(uuid()) @db.Uuid
  /// Which heading it is listed under: "ppfParts", "ppfPartial", "ppfFull",
  /// "glass", "tint", "care", "blackEdition" or "paint".
  section   String   @db.VarChar(20)
  nameAr    String   @map("name_ar") @db.VarChar(80)
  nameEn    String   @map("name_en") @db.VarChar(80)
  noteAr    String?  @map("note_ar") @db.VarChar(200)
  noteEn    String?  @map("note_en") @db.VarChar(200)
  /// The set of packages or films it is priced by (ServiceTier.set); null for one price.
  tierSet   String?  @map("tier_set") @db.VarChar(20)
  /// True when it has separate sedan and SUV prices.
  bodySplit Boolean  @default(false) @map("body_split")
  /// Which of the shop's posters is shown with it ("front-full"); null for none.
  poster    String?  @db.VarChar(40)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices Product[]

  @@index([position])
  @@map("services")
}

/// One column of a service price table: a PPF package ("Package 1 · Xpel"),
/// a tint film ("CARONIC") or a car model ("Leopard 5").
model ServiceTier {
  id       String @id @default(uuid()) @db.Uuid
  /// "ppf", "tint" or "model"
  set      String @db.VarChar(20)
  nameAr   String @map("name_ar") @db.VarChar(40)
  nameEn   String @map("name_en") @db.VarChar(40)
  position Int    @default(0)

  prices Product[]

  @@index([set, position])
  @@map("service_tiers")
}

/// Per-branch showroom display order of the (global) catalog.
model BranchProduct {
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  position  Int

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  /// Re-created as a DEFERRABLE constraint in SQL so a reorder can swap positions in one statement.
  @@unique([branchId, position], map: "branch_products_branch_id_position_key")
  @@map("branch_products")
}

model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedById String   @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([productId, changedAt])
  @@map("price_history")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  /// Per-branch sequence number; `code` is "<branch code>-<number padded to 6>".
  number         Int
  code           String        @unique @db.VarChar(16)
  customerName   String        @map("customer_name") @db.VarChar(80)
  status         OrderStatus   @default(PENDING)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("QAR") @db.Char(3)
  createdById    String        @map("created_by_id") @db.Uuid
  confirmedById  String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledById  String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(80)
  /// SHOWROOM (default) or WEB. Web orders are created by the system.web user
  /// for the website customer below and are confirmed by payment, not by staff.
  source         OrderSource   @default(SHOWROOM)
  customerId     String?       @map("customer_id") @db.Uuid
  /// Snapshots of the website customer's contact details at order time.
  customerPhone  String?       @map("customer_phone") @db.VarChar(20)
  customerEmail  String?       @map("customer_email") @db.VarChar(254)
  paymentStatus  PaymentStatus @default(NONE) @map("payment_status")
  /// When Tap captured the card.
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// When an unpaid web order is cancelled by the expiry sweep (created + CHECKOUT_TTL_MINUTES).
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  /// When the cashier handed a paid web order over, and who.
  collectedById  String?       @map("collected_by_id") @db.Uuid
  collectedAt    DateTime?     @map("collected_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?       @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy User?       @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  collectedBy User?       @relation("OrderCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  odooOutbox  OdooOutbox?

  @@unique([branchId, number])
  @@unique([createdById, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([source, paymentStatus, expiresAt])
  @@map("orders")
}

/// A website customer, separate from staff accounts. Identified by phone;
/// signs in with a one-time code. Name and email are what was last typed at checkout.
model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  /// E.164, e.g. "+97455123456".
  phone          String    @unique @db.VarChar(20)
  name           String?   @db.VarChar(80)
  email          String?   @db.VarChar(254)
  /// Bumped by "sign out everywhere"; cookies carrying an older version stop working.
  sessionVersion Int       @default(1) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

/// One-time sign-in codes. Only the hash is stored; a row dies when consumed,
/// expired, or guessed wrong OTP_MAX_ATTEMPTS times.
model CustomerOtp {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("customer_otps")
}

/// One card attempt at the payment provider. An order may have several
/// (declined, then paid). The charge object Tap last sent is kept as JSON;
/// it never holds a full card number.
model Payment {
  id          String               @id @default(uuid()) @db.Uuid
  orderId     String               @map("order_id") @db.Uuid
  provider    String               @default("tap") @db.VarChar(16)
  /// Tap's charge id ("chg_…"); null until Tap answered.
  chargeId    String?              @unique @map("charge_id") @db.VarChar(64)
  status      PaymentAttemptStatus @default(INITIATED)
  amount      Decimal              @db.Decimal(12, 2)
  currency    String               @default("QAR") @db.Char(3)
  /// Tap's response code, or AMOUNT_MISMATCH when a captured charge did not match the order.
  failureCode String?              @map("failure_code") @db.VarChar(64)
  rawLast     Json?                @map("raw_last")
  refundId    String?              @map("refund_id") @db.VarChar(64)
  refundedAt  DateTime?            @map("refunded_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("payments")
}

/// Paid web orders waiting to become Odoo sale orders. Processed by a timer
/// with backoff; never in the request path.
model OdooOutbox {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @unique @map("order_id") @db.Uuid
  status          OutboxStatus @default(PENDING)
  attempts        Int          @default(0)
  nextAttemptAt   DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError       String?      @map("last_error") @db.VarChar(600)
  odooPartnerId   Int?         @map("odoo_partner_id")
  odooSaleOrderId Int?         @map("odoo_sale_order_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("odoo_outbox")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  /// Snapshots taken at order time, so later renames or price changes never alter the order.
  productName String  @map("product_name") @db.VarChar(120)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  position    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
}

/// A car booked for PPF or tinting at Bin Omran (the only branch that does it).
/// One active FULL booking per receive_date — a partial unique index in SQL.
model PpfBooking {
  id            String         @id @default(uuid()) @db.Uuid
  type          PpfBookingType
  status        BookingStatus  @default(BOOKED)
  car           String         @db.VarChar(80)
  ownerName     String?        @map("owner_name") @db.VarChar(80)
  phone         String?        @db.VarChar(20)
  service       String?        @db.VarChar(200)
  /// The day the car arrives. A FULL booking closes it; a second FULL is the exception.
  receiveDate   DateTime       @map("receive_date") @db.Date
  /// Information only; closes nothing.
  deliveryDate  DateTime?      @map("delivery_date") @db.Date
  note          String?        @db.VarChar(1000)
  createdById   String         @map("created_by_id") @db.Uuid
  updatedById   String?        @map("updated_by_id") @db.Uuid
  cancelledById String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User             @relation("PpfBookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?            @relation("PpfBookingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy User?            @relation("PpfBookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  request     LightJobRequest?

  @@index([receiveDate])
  @@map("ppf_bookings")
}

/// A day the call center closed by hand (holiday, workshop full).
model PpfClosedDay {
  date        DateTime @id @db.Date
  reason      String?  @db.VarChar(200)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("ppf_closed_days")
}

/// A salesperson asking the call center to book a car: a full PPF (an empty
/// day, or the one exception on a booked day) or a light job.
model LightJobRequest {
  id           String                @id @default(uuid()) @db.Uuid
  date         DateTime              @db.Date
  type         PpfBookingType        @default(LIGHT)
  /// Typed by the salesperson; sales have no accounts.
  salesName    String                @map("sales_name") @db.VarChar(80)
  car          String                @db.VarChar(80)
  ownerName    String                @map("owner_name") @db.VarChar(80)
  phone        String?               @db.VarChar(20)
  /// What the job is; required for a light job.
  note         String?               @db.VarChar(1000)
  status       LightJobRequestStatus @default(PENDING)
  decidedById  String?               @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?             @map("decided_at") @db.Timestamptz(3)
  decisionNote String?               @map("decision_note") @db.VarChar(500)
  /// The booking created when the request was approved.
  bookingId    String?               @unique @map("booking_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  decidedBy User?       @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  booking   PpfBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("light_job_requests")
}

/// The call center's private list of every other reservation. No slots.
model GeneralReservation {
  id            String        @id @default(uuid()) @db.Uuid
  date          DateTime      @db.Date
  /// "HH:mm" in Qatar time, when an hour was agreed.
  time          String?       @db.VarChar(5)
  service       String        @db.VarChar(200)
  ownerName     String?       @map("owner_name") @db.VarChar(80)
  phone         String?       @db.VarChar(20)
  car           String?       @db.VarChar(80)
  note          String?       @db.VarChar(1000)
  status        BookingStatus @default(BOOKED)
  createdById   String        @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  cancelledById String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User  @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User? @relation("ReservationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("general_reservations")
}

/// One row (id = 1): the shared PIN of the sales slots page.
model SalesAccess {
  id          Int       @id @default(1)
  pinHash     String?   @map("pin_hash")
  /// Bumped on every PIN change; cookies carrying an older version stop working.
  version     Int       @default(1)
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("sales_access")
}

/// Append-only audit trail (UPDATE/DELETE are blocked by a trigger).
/// Deliberately has no foreign keys: entries must outlive whatever they describe.
model ActivityLog {
  id            BigInt       @id @default(autoincrement())
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId       String?      @map("actor_id") @db.Uuid
  actorUsername String?      @map("actor_username") @db.VarChar(40)
  actorRole     Role?        @map("actor_role")
  branchId      String?      @map("branch_id") @db.Uuid
  action        String       @db.VarChar(64)
  entityType    String?      @map("entity_type") @db.VarChar(32)
  entityId      String?      @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  metadata      Json?
  outcome       AuditOutcome
  ip            String?      @db.VarChar(64)
  userAgent     String?      @map("user_agent") @db.VarChar(512)
  requestId     String?      @map("request_id") @db.VarChar(64)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

/// One run of the Odoo catalogue sync, so the dashboard can say when the
/// catalogue was last brought up to date and whether that worked.
model OdooSyncRun {
  id         String    @id @default(uuid()) @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  /// "schedule", or the id of the user who pressed "Sync now".
  trigger    String    @db.VarChar(40)
  ok         Boolean?
  /// SyncSummary on success.
  summary    Json?
  error      String?   @db.VarChar(600)

  @@index([startedAt])
  @@map("odoo_sync_runs")
}

/// One thing a visitor did on the public website: a page view or a press on a
/// contact button. Anonymous by design: no cookie and no stored IP address;
/// `visitor` is a hash that changes every day, so it only tells one day's
/// visitors apart. Rows older than a year are deleted.
model SiteEvent {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Qatar calendar day of occurredAt.
  day          DateTime @db.Date
  /// One of SITE_EVENT_TYPES.
  type         String   @db.VarChar(24)
  visitor      String   @db.Char(32)
  /// Without the language prefix: "/", "/products".
  path         String   @db.VarChar(200)
  locale       String   @db.VarChar(2)
  /// The first page of a visit; only these rows carry `source`.
  entry        Boolean  @default(false)
  source       String?  @db.VarChar(24)
  referrerHost String?  @map("referrer_host") @db.VarChar(100)
  device       String   @db.VarChar(8)
  /// The branch for a contact press, the product for an add to cart, the car for a model view.
  label        String?  @db.VarChar(160)
  targetId     String?  @map("target_id") @db.VarChar(64)

  @@index([day, type])
  @@index([day, visitor])
  @@map("site_events")
}

# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS (the Next.js app).
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy" setting; the Next.js rewrite proxy runs on loopback.
TRUST_PROXY=loopback
SWAGGER_ENABLED=true

# ---- database --------------------------------------------------------------
DATABASE_URL=postgresql://wolfcar:wolfcar@localhost:5432/wolfcar
# Used only by the API e2e suite (tables are cleared on every run). The name must contain "test".
TEST_DATABASE_URL=postgresql://wolfcar:wolfcar@localhost:5433/wolfcar_test
# Used only by the Playwright browser tests (reseeded on every run). The name must contain "e2e".
E2E_DATABASE_URL=postgresql://wolfcar:wolfcar@localhost:5433/wolfcar_e2e

# ---- auth ------------------------------------------------------------------
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
SHOWROOM_SESSION_TTL_HOURS=2160
# Secure cookies are sent over http://localhost by Chromium and Firefox; keep true.
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Requests per window per IP on the auth endpoints.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# ---- two-factor ------------------------------------------------------------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64=
TOTP_ISSUER=Wolf Car

# ---- files -----------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
# Chromium used for PDF receipts. Leave empty to use Playwright's browser
# (install once: npx playwright install chromium); Docker sets /usr/bin/chromium.
CHROME_PATH=

# ---- odoo ------------------------------------------------------------------
# The product catalogue comes from Odoo. With all four set, the API brings it up
# to date every ODOO_SYNC_MINUTES (0 = never) and on "Sync now" in the dashboard.
# Create the key in Odoo as a dedicated read-only user: My Profile → Account Security → New API Key.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_SYNC_MINUTES=15

# ---- payments (Tap) ----
# Secret key from the Tap dashboard (sk_test_… while testing, sk_live_… in production).
TAP_SECRET_KEY=
TAP_API_URL=https://api.tap.company/v2
# tap | fake (fake is an in-memory gateway for tests; never use it in production)
PAYMENTS_PROVIDER=tap
# Public origins: Tap returns the customer to WEB_PUBLIC_URL and posts its webhook to API_PUBLIC_URL.
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Branch code that holds website orders for pickup, and how long an unpaid order is kept.
WEB_ORDERS_BRANCH_CODE=BO
CHECKOUT_TTL_MINUTES=30
# Customer sign-in by one-time code. "console" prints the SMS to the log.
SMS_PROVIDER=console
# Development only: return the code in the response. Refused when TAP_SECRET_KEY is a live key.
OTP_DEV_CODE_IN_RESPONSE=false
OTP_PER_PHONE_PER_15_MIN=3
CUSTOMER_SESSION_TTL_DAYS=30

# ---- odoo (writing) ----
# A separate Odoo user that creates sale orders for paid website orders. Empty = orders queue until set.
ODOO_WRITE_LOGIN=
ODOO_WRITE_API_KEY=
# Numeric Odoo ids: the warehouse website orders ship from, and a product used when a line has none.
ODOO_WEB_WAREHOUSE_ID=
ODOO_FALLBACK_PRODUCT_ID=

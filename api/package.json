{
  "name": "wolfcar-api",
  "version": "0.1.0",
  "description": "Wolf Car showroom ordering API (NestJS + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/api/src/main.js",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ prisma/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force && npm run db:seed && npm run db:import-legacy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-legacy": "tsx prisma/import-legacy.ts",
    "db:import-odoo": "tsx prisma/import-odoo.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts --runInBand"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nestjs-cls": "7.0.0",
    "nestjs-pino": "5.2.0",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "playwright-core": "1.63.0",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.4",
    "@nestjs/testing": "12.3.3",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "pdf-parse": "2.4.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}

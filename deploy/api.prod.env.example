# Copied to deploy/api.prod.env by scripts/make-env.sh (never committed).
# DATABASE_URL and NODE_ENV are set in compose.prod.yml.
PORT=4000
LOG_LEVEL=info
# Remove the sslip.io and localhost entries after the switch to wolfcar.qa.
CORS_ORIGINS=https://wolfcar.qa,https://www.wolfcar.qa,https://wolfcar.167-172-106-106.sslip.io,http://localhost:3000
# Caddy (loopback) -> web container (Docker network, private range) -> api
TRUST_PROXY=loopback, uniquelocal
SWAGGER_ENABLED=false
JWT_ACCESS_SECRET=__GENERATED__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
SHOWROOM_SESSION_TTL_HOURS=2160
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60
TOTP_ENCRYPTION_KEY=__GENERATED__
TOTP_ISSUER=Wolf Car

# ---- odoo ------------------------------------------------------------------
# The product catalogue comes from Odoo. With all four set, the API brings it up
# to date every ODOO_SYNC_MINUTES (0 = never) and on "Sync now" in the dashboard.
# Use a dedicated read-only Odoo user and its API key; never a personal account.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_SYNC_MINUTES=15

# ---- payments (Tap) ----
# MUST be set on the server. Secret key from the Tap dashboard (sk_test_… while testing, sk_live_… in production).
# The card form's public key (NEXT_PUBLIC_TAP_PUBLIC_KEY) belongs to the web container, not here.
TAP_SECRET_KEY=
TAP_API_URL=https://api.tap.company/v2
# tap | fake (fake is an in-memory gateway for tests; the API refuses fake in production: its webhook accepts signatures made with the public 'fake-secret')
PAYMENTS_PROVIDER=tap
# Public origins (no trailing slash): Tap returns the customer to WEB_PUBLIC_URL and posts its webhook to API_PUBLIC_URL.
WEB_PUBLIC_URL=https://wolfcar.qa
API_PUBLIC_URL=https://wolfcar.qa
# Tap must reach POST /api/shop/payments/tap/webhook on API_PUBLIC_URL from the internet.
# Branch code that holds website orders for pickup, and how long an unpaid order is kept.
WEB_ORDERS_BRANCH_CODE=BO
CHECKOUT_TTL_MINUTES=30
# Customer sign-in by one-time code. "console" prints every code to the log: replace it with a real SMS sender before real customers sign in.
SMS_PROVIDER=console
# Development only: return the code in the response. MUST stay false here (the API refuses true in production).
OTP_DEV_CODE_IN_RESPONSE=false
# Never set ALLOW_TEST_CHECKOUT here: it is for the browser tests, which run the API as production with the fake gateway.
OTP_PER_PHONE_PER_15_MIN=3
CUSTOMER_SESSION_TTL_DAYS=30

# ---- odoo (writing) ----
# MUST be set on the server. A separate Odoo user (not the read-only one above) that creates sale orders for paid website orders. Empty = orders queue until set.
ODOO_WRITE_LOGIN=
ODOO_WRITE_API_KEY=
# MUST be set on the server. Numeric Odoo ids: the Bin Omran warehouse website orders ship from, and a product used when a line has none.
ODOO_WEB_WAREHOUSE_ID=
ODOO_FALLBACK_PRODUCT_ID=
